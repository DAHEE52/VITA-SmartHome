SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# 백엔드는 이 값을 직접 검증하지 않는다(app/deps.py의 verify_device_key가 기기별 개별 키를
# DB에서 관리함, trust-on-first-use). 이 값은 firmware/*/config.h.example들의 기본
# DEVICE_KEY 값과 그냥 맞춰둔 것뿐이라 참고용으로만 남겨둔다 - 실제로 새 기기가 처음
# 등록할 때 들고 오는 키가 그 기기의 영구 키로 저장된다.
DEVICE_API_KEY=345e01dbf13a5ba7d12843403115746a7f18b270431bc565

# tapo_mqtt_publisher.py / tapo_mqtt_bridge.py 전용 - TP-Link Tapo 스마트플러그(P100/P105/
# P110/P110M/P115)를 라즈베리파이에서 쓸 때만 필요. 이 둘은 라즈베리파이 안에서 로컬 MQTT
# 브로커(Mosquitto)를 통해 서로 통신한다 - ESP32 노드/백엔드는 지금처럼 HTTP만 그대로 쓴다.
# TAPO_USERNAME/PASSWORD는 Tapo 앱 로그인 계정(로컬 인증에도 필요).
# 앱에서 "나 > 제3자 서비스 > 제3자 호환성"을 켜야 python 라이브러리로 접속 가능하다.
# IP를 직접 지정할 필요는 없다 - 발행자가 주기적으로 네트워크를 검색해서 자동으로 찾는다.
TAPO_USERNAME=your-tapo-account@example.com
TAPO_PASSWORD=your-tapo-password
# 기본값(255.255.255.255, 전체 브로드캐스트)으로 대부분의 가정용 공유기에서 동작한다.
# 검색이 안 되면 공유기의 서브넷 브로드캐스트(예: 192.168.0.255)로 바꿔본다.
TAPO_DISCOVERY_TARGET=255.255.255.255
# 라즈베리파이에 설치한 Mosquitto 주소. 두 스크립트 모두 같은 Pi에서 돌면 기본값 그대로 둔다.
MQTT_HOST=localhost
MQTT_PORT=1883
# tapo_mqtt_bridge.py가 이 백엔드를 호출할 주소. 같은 기기에서 실행하면 기본값 그대로 둔다.
API_BASE_URL=http://localhost:8000

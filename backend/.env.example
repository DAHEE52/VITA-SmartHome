SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# 미리 생성해둔 랜덤 키. firmware/*/config.h의 DEVICE_KEY와 반드시 동일해야 함.
DEVICE_API_KEY=345e01dbf13a5ba7d12843403115746a7f18b270431bc565

# tapo_power_bridge.py 전용 - TP-Link Tapo 스마트플러그(P110M 등)로 전력을 측정할 때만 필요.
# TAPO_USERNAME/PASSWORD는 Tapo 앱 로그인 계정(로컬 인증에도 필요), TAPO_IP는 플러그의 LAN IP.
# 앱에서 "나 > 제3자 서비스 > 제3자 호환성"을 켜야 python 라이브러리로 접속 가능하다.
TAPO_USERNAME=your-tapo-account@example.com
TAPO_PASSWORD=your-tapo-password
TAPO_IP=192.168.0.xxx
# tapo_power_bridge.py가 이 백엔드를 호출할 주소. 같은 기기에서 실행하면 기본값 그대로 둔다.
API_BASE_URL=http://localhost:8000

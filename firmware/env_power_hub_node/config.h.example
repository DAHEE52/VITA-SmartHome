#pragma once

// 이 파일을 config.h로 복사한 뒤 실제 값으로 채운다. config.h는 커밋하지 않는다.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// FastAPI 서버가 떠 있는 PC의 LAN IP:port. 실제 실행 PC/네트워크가 다르면 ipconfig로 확인해서 바꿀 것.
#define API_BASE_URL "http://192.168.200.141:8000"

// 이 기기만의 인증 키 - 자유롭게 정해도 된다(다른 노드와 같은 값을 써도 무방).
// 백엔드가 이 기기의 첫 등록 요청에 실려온 값을 그대로 저장해서 그 이후부터는
// 이 값으로만 인증한다(trust-on-first-use) - VITA/backend/.env의 DEVICE_API_KEY와
// 더 이상 반드시 같을 필요는 없음. 키를 재발급하려면 백엔드에서 이 기기를 삭제 후 재부팅.
#define DEVICE_KEY "345e01dbf13a5ba7d12843403115746a7f18b270431bc565"

// 이 보드는 온습도/조도(env_sensor)와 전력(power_monitor) 두 device_id로 등록된다.
#define ENV_DEVICE_ID "living-env-01"
#define POWER_DEVICE_ID "living-power-01"

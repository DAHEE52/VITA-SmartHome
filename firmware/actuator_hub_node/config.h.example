#pragma once

// 이 파일을 config.h로 복사한 뒤 실제 값으로 채운다. config.h는 커밋하지 않는다.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// FastAPI 서버가 떠 있는 PC의 LAN IP:port. 실제 실행 PC/네트워크가 다르면 ipconfig로 확인해서 바꿀 것.
#define API_BASE_URL "http://192.168.200.141:8000"

// VITA/backend/.env 의 DEVICE_API_KEY와 반드시 동일해야 함 (이미 맞춰서 생성해둔 값)
#define DEVICE_KEY "345e01dbf13a5ba7d12843403115746a7f18b270431bc565"


// PIR(재실) 1개 + 릴레이 4개 device_id
#define PRESENCE_DEVICE_ID "living-presence-01"
#define RELAY1_DEVICE_ID "living-relay-01"
#define RELAY2_DEVICE_ID "living-relay-02"
#define RELAY3_DEVICE_ID "living-relay-03"
#define RELAY4_DEVICE_ID "living-relay-04"

// 채널별 active level. GPIO에 저항+LED를 직결한 채널은 HIGH를 줘야 켜지므로(active-HIGH)
// HIGH로 두고, 옵토릴레이 모듈을 쓰는 채널은 대부분 LOW를 줘야 켜지므로(active-LOW) LOW로
// 둔다. 기본값은 "채널1 = 조명 LED 직결", "채널2~4 = 옵토릴레이 모듈"을 가정한 것 -
// 실제 배선과 다르면 반드시 실측(딸깍 소리/LED 점등) 후 맞춰 바꿀 것.
#define RELAY1_ACTIVE_LEVEL HIGH  // 조명 LED 직결
#define RELAY2_ACTIVE_LEVEL LOW
#define RELAY3_ACTIVE_LEVEL LOW
#define RELAY4_ACTIVE_LEVEL LOW

#pragma once

// 이 파일을 config.h로 복사한 뒤 실제 값으로 채운다. config.h는 커밋하지 않는다.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// AWS Lambda에 배포된 백엔드(원격, HTTPS 전용). backend/DEPLOY_AWS.md 참고.
// 로컬 백엔드(http://)로 테스트하려면 이 값을 LAN IP로 바꾸는 것만으로는 안 된다 - .ino의
// secureClient(WiFiClientSecure, TLS 전용)로는 평문 HTTP 서버에 연결할 수 없으므로,
// http.begin(secureClient, ...) 호출도 함께 http.begin(...)(클라이언트 인자 없이)로 되돌려야 한다.
#define API_BASE_URL "https://yngndbonhttzfuptrjxrywoqs40iblyr.lambda-url.ap-northeast-2.on.aws"

// 이 기기만의 인증 키 - 자유롭게 정해도 된다(다른 노드와 같은 값을 써도 무방).
// 백엔드가 이 기기의 첫 등록 요청에 실려온 값을 그대로 저장해서 그 이후부터는
// 이 값으로만 인증한다(trust-on-first-use) - VITA/backend/.env의 DEVICE_API_KEY와
// 더 이상 반드시 같을 필요는 없음. 키를 재발급하려면 백엔드에서 이 기기를 삭제 후 재부팅.
#define DEVICE_KEY "345e01dbf13a5ba7d12843403115746a7f18b270431bc565"

// 이 노드의 고유 ID와 소속 방 이름
#define DEVICE_ID "living-life-pattern-cam-01"
